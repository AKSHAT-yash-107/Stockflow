# Copy this file to .env and fill in your local PostgreSQL values.
PGHOST=localhost
PGPORT=5432
PGDATABASE=stockflow
PGUSER=postgres
PGPASSWORD=replace_me

# AWS configuration for Stockflow S3 Bronze.
AWS_REGION=ap-south-1
STOCKFLOW_S3_BUCKET=replace-with-your-private-bucket-name

# Authentication is supplied by an AWS profile, IAM Identity Center,
# or an attached IAM role. Never place AWS access keys in this file.
